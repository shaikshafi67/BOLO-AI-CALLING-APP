NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://user:password@localhost:5432/boloai


AUTH_SECRET=replace-with-a-long-random-secret

# Path to the downloaded GCP service account JSON key (never commit this file)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# Firebase Admin SDK (for verifying client auth tokens)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Mailbox that sends the 6-digit code after sign-up. Without it (in development)
# the code is printed in the server log instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BoloAI <noreply@yourdomain.com>"

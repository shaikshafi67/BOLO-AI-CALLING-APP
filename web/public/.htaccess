# Hostinger / Apache: serve the React app for every route (e.g. /dashboard,
# /call/BOLO-1234) so refreshing or opening a link doesn't show 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Always use https (camera and microphone only work on secure pages).
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# New builds take effect immediately; hashed assets can be cached for a year.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|jpg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Firebase sign-in helper pages (public/__/auth/handler and iframe) have no
# file extension: serve them as web pages.
<FilesMatch "^(handler|iframe)$">
  ForceType text/html
</FilesMatch>
